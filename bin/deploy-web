#!/bin/sh
# Build + deploy the web UI in place. The bundle HARD-REQUIRES the KV token
# at build time (env.ts must()) - building without it ships a blank site,
# which happened once on 2026-07-13. Always deploy through this script.
#
# Usage: bin/deploy-web
set -eu
cd "$(dirname "$0")/.."
if [ ! -f .env ]; then
  echo "ERROR: .env missing (needs KV_TOKEN)"; exit 1
fi
set -a; . ./.env; set +a
export PATH="$HOME/.local/node/bin:$PATH"
# T-12: no credential is baked into the bundle. The server authenticates
# /kv via validated Access identity; KV_TOKEN stays server-side only.
npm -w apps/web run build
# Smoke: server must be healthy and serving the fresh bundle hash.
HASH=$(ls apps/web/dist/assets/index-*.js | head -1 | sed 's/.*index-//; s/\.js//')
curl -sf http://127.0.0.1:8210/healthz > /dev/null || { echo "ERROR: server unhealthy"; exit 1; }
curl -sf http://127.0.0.1:8210/ | grep -q "$HASH" || { echo "ERROR: served index.html does not reference fresh bundle $HASH"; exit 1; }
echo "OK: deployed bundle index-$HASH.js and server is serving it."
# T-61: the visual gate. Captures the fixed state matrix, diffs against the
# last deploy, and FAILS this script when frames changed (exit 2) or lack a
# baseline (exit 3). Review .visual-gate/diff, then promote deliberately with
# `npm run visual-gate:baseline`. After a human has reviewed, re-run with
# VISUAL_GATE_ACK=1 to acknowledge and pass.
# set -eu is active above: capture the exit WITHOUT letting -e kill the
# script before the case (rev3 review finding — the case was unreachable).
GATE_EXIT=0
npm run visual-gate --silent || GATE_EXIT=$?
case "$GATE_EXIT" in
  0) : ;;
  2|3)
    if [ "${VISUAL_GATE_ACK:-}" = "1" ]; then
      echo "visual-gate: pixel/baseline differences ACKNOWLEDGED by deployer (VISUAL_GATE_ACK=1)"
    else
      echo "visual-gate FAILED (exit $GATE_EXIT): review .visual-gate/diff, then promote or re-run with VISUAL_GATE_ACK=1"
      exit "$GATE_EXIT"
    fi ;;
  *)
    # Geometry defects (4) and incomplete captures (5) are NEVER acknowledgeable:
    # they are deterministic product/tooling failures, not review judgment calls.
    echo "visual-gate HARD FAIL (exit $GATE_EXIT): geometry defects or incomplete capture — fix before deploying"
    exit "$GATE_EXIT" ;;
esac
