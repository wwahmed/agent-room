#!/bin/sh
# T-95: resumable release pipeline. STAGE -> GATE -> APPROVE -> WALKTHROUGH
# -> PROMOTE, with every phase recorded on disk under releases/<full-sha>/
# so an interrupted run continues where it stopped. Each build is an
# immutable, read-only, content-hashed artifact; live serving is a symlink
# flip; rollback is bin/rollback-web. scripts/release-pipeline.mjs holds the
# state machine (tested by scripts/release-pipeline.test.mjs).
#
# Channels:
#   normal : bin/deploy-web
#            Requires ALL of: green (or acked-pixel) visual gate against the
#            staging preview; a "RELEASE-APPROVE <full-sha>" room message
#            from a non-builder; a validated walkthrough receipt
#            (WALKTHROUGH_RECEIPT=path) or an explicit recorded skip
#            (WALKTHROUGH_SKIP_REASON="...").
#   hotfix : DEPLOY_HOTFIX=1 DEPLOY_REASON="..." bin/deploy-web
#            Host-declared critical ONLY. Logged; leaves hotfix debt that
#            only a subsequent fully-green normal deploy clears.
#
# The staging preview keeps running between invocations (pid recorded in the
# release dir) so reviewers can look at it for as long as the ruling takes.
set -eu
cd "$(dirname "$0")/.."
[ -f .env ] || { echo "ERROR: .env missing (needs KV_TOKEN)"; exit 1; }
set -a; . ./.env; set +a
export PATH="$HOME/.local/node/bin:$PATH"

PIPELINE="node scripts/release-pipeline.mjs"
SHA=$(git rev-parse HEAD)
STAGING_PORT="${STAGING_PORT:-8220}"
export DEPLOY_BY="${DEPLOY_BY:-$(git config user.name)}"

# 1. Stage (no-op if this SHA is already an immutable release).
$PIPELINE stage

# 2. Durable staging preview for the gate and for reviewer eyes.
node --input-type=module - "$SHA" "$STAGING_PORT" <<'EOF'
import { serveStaging, releaseDir, waitForHealth } from './scripts/release-pipeline.mjs';
const [sha, port] = process.argv.slice(2);
const info = serveStaging(process.cwd(), releaseDir(process.cwd(), sha), { port: Number(port) });
const ok = await waitForHealth(`http://127.0.0.1:${info.port}/healthz`);
if (!ok) { console.error(`ERROR: staging server not healthy (log: ${info.log})`); process.exit(1); }
console.log(`staging: ${sha} on http://127.0.0.1:${info.port} (pid ${info.pid}, persists until promote/reject)`);
EOF

if [ "${DEPLOY_HOTFIX:-}" = "1" ]; then
  echo "HOTFIX LANE: promoting $SHA without gate; debt recorded, cleared only by the next fully-green normal deploy"
  $PIPELINE promote "$SHA"
else
  # 3. Full visual gate against STAGING. Red = stop, live untouched.
  GATE_EXIT=0
  VISUAL_GATE_BASE="http://127.0.0.1:$STAGING_PORT" npm run visual-gate --silent || GATE_EXIT=$?
  $PIPELINE gate "$SHA" "$GATE_EXIT" || {
    echo "visual-gate exit $GATE_EXIT blocked the release. LIVE IS UNCHANGED (staging preview stays up for review)."
    exit "$GATE_EXIT"
  }

  # 4. Authenticated second-person approval from the room.
  $PIPELINE approve-check "$SHA" || {
    echo "Waiting on approval. Staging preview: http://127.0.0.1:$STAGING_PORT - re-run bin/deploy-web after the approval message; completed phases resume."
    exit 6
  }

  # 5. Walkthrough receipt (T-89) - validated, or an explicit reasoned skip.
  $PIPELINE walkthrough "$SHA" || {
    echo "BLOCKED: no walkthrough. Provide WALKTHROUGH_RECEIPT=path or WALKTHROUGH_SKIP_REASON=\"...\". LIVE IS UNCHANGED."
    exit 7
  }

  # 6. Atomic pointer promotion + live verification (auto-reverts on failure).
  $PIPELINE promote "$SHA"
fi

# Retire the staging preview now that a ruling exists.
node --input-type=module - "$SHA" <<'EOF'
import { stagingInfo, releaseDir } from './scripts/release-pipeline.mjs';
const info = stagingInfo(releaseDir(process.cwd(), process.argv[2]));
if (info) { try { process.kill(-info.pid); } catch { try { process.kill(info.pid); } catch {} } }
EOF
$PIPELINE status
