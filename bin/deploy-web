#!/bin/sh
# T-95: resumable release pipeline. RECONCILE -> STAGE -> SERVE -> GATE ->
# CHALLENGE -> APPROVE -> WALKTHROUGH -> PROMOTE, every phase recorded on
# disk under releases/<full-sha>/ so an interrupted run continues where it
# stopped (scripts/release-pipeline.mjs holds the state machine; tests in
# scripts/release-pipeline.test.mjs). Builds are immutable, read-only,
# content-hashed artifacts; live serving is an atomic symlink flip; rollback
# is bin/rollback-web.
#
# Non-negotiables (no bypasses exist):
#   - dirty trees are refused outright; a release maps to a commit
#   - normal promotion requires: green visual gate against the bound staging
#     preview; a verbatim challenge-line approval posted in the room by a
#     REGISTERED approver (scripts/release-approvers.json) outside the
#     builder lineage; and a T-89 walkthrough receipt whose digests match
#     this exact artifact, fixture set, and gate result
#   - hotfix lane (DEPLOY_HOTFIX=1 DEPLOY_REASON="...") records debt that
#     only a fully-green normal promote CONTAINING those commits clears
set -eu
cd "$(dirname "$0")/.."
[ -f .env ] || { echo "ERROR: .env missing (needs KV_TOKEN)"; exit 1; }
set -a; . ./.env; set +a
export PATH="$HOME/.local/node/bin:$PATH"

PIPELINE="node scripts/release-pipeline.mjs"
SHA=$(git rev-parse HEAD)
export DEPLOY_BY="${DEPLOY_BY:-$(git config user.name)}"

# 0. Self-heal any interrupted prior run before doing anything else.
$PIPELINE reconcile

# 1. Stage (no-op if this SHA is already an immutable release).
$PIPELINE stage

# 2. Durable staging preview, bound to this release's artifact digest.
$PIPELINE serve "$SHA"

if [ "${DEPLOY_HOTFIX:-}" = "1" ]; then
  echo "HOTFIX LANE: promoting $SHA without gate; debt recorded, cleared only by a fully-green normal deploy containing it"
  $PIPELINE promote "$SHA"
else
  # 3. Full visual gate against the STAGING preview. Red = stop, live untouched.
  STAGING_PORT_ACTUAL=$(node -e "import('./scripts/release-pipeline.mjs').then(m => console.log(m.stagingInfo(m.releaseDir(process.cwd(), '$SHA')).port))")
  GATE_EXIT=0
  VISUAL_GATE_BASE="http://127.0.0.1:$STAGING_PORT_ACTUAL" npm run visual-gate --silent || GATE_EXIT=$?
  $PIPELINE gate "$SHA" "$GATE_EXIT" || {
    echo "visual-gate exit $GATE_EXIT blocked the release. LIVE IS UNCHANGED (staging preview stays up for review)."
    exit "$GATE_EXIT"
  }

  # 4. Challenge line for the approver, then check for the attested approval.
  $PIPELINE challenge "$SHA"
  $PIPELINE approve-check "$SHA" || {
    echo "Waiting on approval: a registered approver must post the challenge line above, verbatim, in the room."
    echo "Staging preview: http://127.0.0.1:$STAGING_PORT_ACTUAL - re-run bin/deploy-web afterward; completed phases resume."
    exit 6
  }

  # 5. Walkthrough receipt (T-89), digest-bound to this release. Required.
  $PIPELINE walkthrough "$SHA" || {
    echo "BLOCKED: WALKTHROUGH_RECEIPT=path required and it must match this release's digests. LIVE IS UNCHANGED."
    exit 7
  }

  # 6. Atomic pointer promotion + live verification (auto-reverts on failure).
  $PIPELINE promote "$SHA"
fi

# Retire the staging preview now that a ruling exists.
node --input-type=module - "$SHA" <<'EOF'
import { killStaging, releaseDir } from './scripts/release-pipeline.mjs';
killStaging(releaseDir(process.cwd(), process.argv[2]));
EOF
$PIPELINE status
