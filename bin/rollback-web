#!/bin/sh
# T-95: atomic rollback - flip the live pointer to the previous release and
# verify health. Running it twice rolls forward again (the pointer pair
# swaps), so a drill is safe. History stays in releases/release-log.txt.
set -eu
cd "$(dirname "$0")/.."
export PATH="$HOME/.local/node/bin:$PATH"
DEPLOY_BY="${DEPLOY_BY:-$(git config user.name)}" node scripts/release-pipeline.mjs rollback
