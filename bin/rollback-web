#!/bin/sh
# T-86: atomic rollback to the previous live web bundle (the dist the last
# promotion displaced). One level deep by design — history lives in git.
set -eu
cd "$(dirname "$0")/.."
LIVE_DIST="apps/web/dist"
[ -d "$LIVE_DIST.prev" ] || { echo "ERROR: no $LIVE_DIST.prev to roll back to"; exit 1; }
mv "$LIVE_DIST" "$LIVE_DIST.rolledback" 2>/dev/null || true
mv "$LIVE_DIST.prev" "$LIVE_DIST"
curl -sf http://127.0.0.1:8210/healthz > /dev/null || { echo "WARNING: live server unhealthy after rollback"; exit 1; }
HASH=$(ls $LIVE_DIST/assets/index-*.js | head -1 | sed 's/.*index-//; s/\.js//')
echo "$(date -u +%FT%TZ) rolled back to index-$HASH.js" >> .visual-gate/hotfix-log.txt
echo "OK: rolled back; live serves index-$HASH.js (displaced bundle kept at dist.rolledback)"
